    {
      "file": "templates/agents/scripts/worktree-remove.sh",
      "line": "52",
      "area": "correctness",
      "confidence": "high",
      "tag": "nit",
      "description": "An earlier release's worktree-create.sh had no name check, so it could create a dot-named worktree such as `.worktrees/.scratch`. Under the new `.*` rule, `worktree-remove.sh .scratch` prints 'Skipped' and exits 0, and `--merged` never visits it, so the only way out is a manual `git worktree remove`. Naming that in the message or the CHANGELOG would save users from a dead end.",
      "body": null,
      "suggestion": null
    }

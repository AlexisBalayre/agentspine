{
  "name": "agentspine",
  "version": "0.1.2",
  "description": "One-shot scaffolder for a shared agent setup across Claude Code, Codex, opencode, Mistral Vibe, and Cursor.",
  "type": "module",
  "license": "MIT",
  "author": "Alexis Balayre",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexisBalayre/agentspine.git"
  },
  "keywords": [
    "agents",
    "AGENTS.md",
    "agents-md",
    "claude-code",
    "codex",
    "opencode",
    "mistral-vibe",
    "cursor",
    "skills",
    "agent-skills",
    "hooks",
    "ai-agents",
    "coding-agents",
    "ai-coding-assistant",
    "code-review",
    "scaffolding",
    "developer-tools",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentspine": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
